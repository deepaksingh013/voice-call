# Local development only. Copy to .env and leave as-is — these match
# docker-compose.yml.
#
# DO NOT paste these into a hosting provider. On Render, Railway or Fly the
# database and Redis run on their machines, not yours, so 127.0.0.1 there
# means "this container", where nothing is listening. Use the Internal
# Connection String your provider gives you.

NODE_ENV=development
PORT=4000

# LOCAL ONLY — from docker-compose.yml.
DATABASE_URL="postgresql://voiceonly:voiceonly@127.0.0.1:5434/voiceonly?schema=public"
# LOCAL ONLY — from docker-compose.yml.
REDIS_URL="redis://127.0.0.1:6381"

# Generate a fresh one per environment, never reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-real-secret-at-least-32-chars"

DEVICE_TOKEN_TTL_DAYS=365
SESSION_TTL_DAYS=30

# Comma-separated allowlist. In production this is your real frontend URL,
# with no trailing slash.
CORS_ORIGIN="http://localhost:3000"

VOICE_SERVICE_URL="http://localhost:8000"
# Below this, an inferred gender is treated as unknown and the caller stays
# out of gender-filtered pools. Tune for precision on the female class.
VOICE_CONFIDENCE_THRESHOLD=0.90

# Testing only. Returns login codes in the API response instead of emailing
# them, which lets ANYONE sign in as ANY email address. Leave false unless you
# are the only person using the deployment.
UNSAFE_RETURN_LOGIN_CODES=false
